{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample TODO API",
    "description": "A simple TODO list API for demonstration",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://jsonplaceholder.typicode.com",

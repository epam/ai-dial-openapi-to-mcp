# Server
# Host port mapped to the container's fixed port 8080.
HOST_PORT=8080
LOG_LEVEL=INFO

# Cache
MCP_CACHE_MAX_SIZE=100
MCP_CACHE_TTL=3600
MCP_CACHE_CLEANUP_INTERVAL=300

# Tool schemas, calls and responses
# Inline $ref in tool schemas (true) or keep $ref/$defs (false; use for huge recursive specs)
MCP_DEREFERENCE_SCHEMAS=true
# Validate JSON tool results against the output schemas from the spec (false turns it off)
MCP_VALIDATE_OUTPUT=true
# Keep "/" in every path parameter instead of encoding it (default false; can also be
# set per parameter with x-mcp-allow-reserved: true in the spec)
PATH_PARAMS_ALLOW_RESERVED=false

# OpenAPI spec delivered by URL (X-OPENAPI-URL / openapi_url)
OPENAPI_FETCH_TIMEOUT=10
OPENAPI_FETCH_MAX_BYTES=10485760
OPENAPI_URL_CACHE_TTL=3600
# Serve the previous schema this many extra seconds if a refetch fails (0 disables)
OPENAPI_URL_CACHE_STALE_TTL=86400
OPENAPI_URL_CACHE_MAX_ENTRIES=32
# Send extra_headers and the DIAL credential on the schema request (default false: anonymous)
OPENAPI_FETCH_SEND_AUTH=false

# Comma-separated request-header names that clients may forward to the
# selected API. Outbound destination restriction is expected to be enforced
# by external network egress controls, not by this service.
OUTBOUND_HEADER_ALLOWLIST=x-request-id

# Comma-separated request-header names that can never be forwarded. This
# replaces the built-in default; leave unset to use the default shown below.
# OUTBOUND_HEADER_BLOCKLIST=authorization,cookie,set-cookie,proxy-authorization,host,connection,keep-alive,proxy-authenticate,te,trailer,transfer-encoding,upgrade,forwarded,x-forwarded-for,x-forwarded-host,x-forwarded-proto

# Optional DIAL integration. DIAL_CORE_URL is a backward-compatible fallback.
# DIAL_URL=https://dial.example.com
# DIAL_CORE_URL=https://dial.example.com

# OpenTelemetry (all disabled unless the matching *_EXPORTER var is set)
# OTEL_SERVICE_NAME=openapi-to-mcp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy-otel.monitoring.svc.cluster.local:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp,prometheus
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

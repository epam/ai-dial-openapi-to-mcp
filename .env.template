# Server
# Host port mapped to the container's fixed port 8080.
HOST_PORT=8080
LOG_LEVEL=INFO

# Cache
MCP_CACHE_MAX_SIZE=100
MCP_CACHE_TTL=3600
MCP_CACHE_CLEANUP_INTERVAL=300

# Comma-separated request-header names that clients may forward to the
# selected API. Outbound destination restriction is expected to be enforced
# by external network egress controls, not by this service.
OUTBOUND_HEADER_ALLOWLIST=x-request-id

# Comma-separated request-header names that can never be forwarded. This
# replaces the built-in default; leave unset to use the default shown below.
# OUTBOUND_HEADER_BLOCKLIST=authorization,cookie,set-cookie,proxy-authorization,host,connection,keep-alive,proxy-authenticate,te,trailer,transfer-encoding,upgrade,forwarded,x-forwarded-for,x-forwarded-host,x-forwarded-proto

# Optional DIAL integration. DIAL_CORE_URL is a backward-compatible fallback.
# DIAL_URL=https://dial.example.com
# DIAL_CORE_URL=https://dial.example.com
